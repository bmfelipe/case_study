# Solo desarrollo local. No reutilizar estas credenciales en producción.
POSTGRES_PASSWORD=local_only_change_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=local-dev-key-not-for-production

# Opcional: URL HTTPS hacia otro CSV con la misma cabecera.
# Si está vacío, el DAG copia el CSV incluido en este repositorio.
SOURCE_URL=
# Si se usa SOURCE_URL, declarar sus hosts permitidos (y los de posibles redirecciones).
# Ejemplo: SOURCE_ALLOWED_HOSTS=datos.ejemplo.com,cdn.ejemplo.com
SOURCE_ALLOWED_HOSTS=