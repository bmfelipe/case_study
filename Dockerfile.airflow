FROM apache/airflow:2.10.5-python3.11

# dbt está en su propio virtualenv para no resolver ni modificar las
# dependencias de Airflow. Los volúmenes vacíos heredan estos permisos.
USER root
RUN mkdir -p /opt/airflow/shared /opt/airflow/logs /opt/dbt-venv \
    && chown -R 50000:0 /opt/airflow/shared /opt/airflow/logs /opt/dbt-venv

USER airflow
RUN python -m venv /opt/dbt-venv \
    && /opt/dbt-venv/bin/pip install --no-cache-dir 'dbt-core>=1.9,<1.10' dbt-postgres==1.9.0 \
    && pip install --no-cache-dir psycopg2-binary==2.9.10